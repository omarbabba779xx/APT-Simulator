# Multi-stage build for the APT Simulator orchestrator.
#
#   docker build -f Dockerfile.orchestrator -t apt-sim/orchestrator:latest .
#   docker run --rm -p 8765:8765 apt-sim/orchestrator:latest

FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY orchestrator/ orchestrator/
COPY ttps/ ttps/
COPY agent/ agent/
COPY scenarios/ scenarios/
COPY config/ config/

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --prefix=/install -e .


FROM python:3.12-slim AS runtime

LABEL org.opencontainers.image.title="apt-simulator-orchestrator"
LABEL org.opencontainers.image.description="Defensive APT emulation orchestrator (FastAPI)"

RUN useradd --create-home --uid 10001 app

WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=builder /build /app

# Default config + scenarios live in /app. Mount /app/data for persistent state.
RUN mkdir -p /app/data /app/keys && chown -R app:app /app

USER app

EXPOSE 8765

ENV PYTHONUNBUFFERED=1 \
    APT_SIM_HOST=0.0.0.0 \
    APT_SIM_PORT=8765

# Health check probes the FastAPI healthz endpoint.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request,sys; \
        sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8765/healthz', timeout=3).status==200 else 1)"

CMD ["python", "-m", "orchestrator.main", "serve", "--host", "0.0.0.0", "--port", "8765"]
