# Normalize line endings for all text files to LF in the repo.
# Windows checkouts will still get CRLF via core.autocrlf, but the repo
# always stores LF — prevents spurious CI diffs across Linux/macOS/Windows.

* text=auto eol=lf

# Force LF for shell scripts and YAML (critical for CI correctness)
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Python — LF in repo, tools handle platform line endings at runtime
*.py text eol=lf

# Windows-specific scripts get CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — no EOL conversion
*.png binary
*.jpg binary
*.ico binary
*.gz binary
*.zip binary
*.whl binary
