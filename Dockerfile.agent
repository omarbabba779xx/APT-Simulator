# APT Simulator agent — slim Linux image.
#
#   docker build -f Dockerfile.agent -t apt-sim/agent:latest .
#   docker run --rm --network host apt-sim/agent:latest \
#       run --server http://orchestrator:8765 --ttl-seconds 3600
#
# The agent intentionally does NOT include FastAPI/uvicorn/SQLModel — only the
# minimal set needed to beacon and execute simulation TTPs.

FROM python:3.12-slim AS builder

WORKDIR /build

COPY pyproject.toml ./
COPY agent/ agent/
COPY ttps/ ttps/
COPY orchestrator/core/ orchestrator/core/
COPY orchestrator/__init__.py orchestrator/__init__.py
COPY config/ config/

# Install only the runtime deps the agent uses; explicitly avoid server stack.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --prefix=/install \
        "httpx>=0.27" \
        "cryptography>=42.0" \
        "pydantic>=2.6" \
        "PyYAML>=6.0" \
        "typer>=0.9" \
        "rich>=13.7"


FROM python:3.12-slim AS runtime

LABEL org.opencontainers.image.title="apt-simulator-agent"
LABEL org.opencontainers.image.description="APT Simulator beacon agent (lab-only)"

RUN useradd --create-home --uid 10002 agent

WORKDIR /app
COPY --from=builder /install /usr/local
COPY --from=builder /build /app
RUN chown -R agent:agent /app

USER agent

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "-m", "agent.main"]
CMD ["run", "--server", "http://orchestrator:8765"]
